            "$type": "color",
            "$value": "{success.content.inverse}"
          },
          "DEFAULT": {
            "$type": "color",
            "$value": "{success.content.DEFAULT}"
          }
        },
        "error": {
          "text": {
            "$type": "color",
            "$value": "{error.content.inverse}"
          },
          "DEFAULT": {
            "$type": "color",
            "$value": "{error.content.DEFAULT}"
          }
        }
      },
      "label": {
        "color": {
          "$type": "color",
          "$value": "{base.content.DEFAULT}"
        }
      }
    },
    "toggle": {
      "background": {
        "$type": "color",
        "$value": "{base.background.hover}"
      },
      "color": {
        "$type": "color",
        "$value": "{base.content.DEFAULT}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{base.border}"
      },
      "thumb-shadow": {
        "$type": "color",
        "$value": "{base.shadow}"
      }
    },
    "tabs": {
      "background": {
        "$type": "color",
        "$value": "{base.background.component}"
      },
      "color": {
        "$type": "color",
        "$value": "{base.content.DEFAULT}"
      },
      "border": {
        "color": {
          "$type": "color",
          "$value": "{base.border}"
        }
      },
      "accent": {
        "$type": "color",
        "$value": "{primary.content.DEFAULT}"
      }
    },
    "splitter": {
      "handle": {
        "background": {
          "$type": "color",
          "$value": "{base.background.component}"
        },
        "hover-background": {
          "$type": "color",
          "$value": "{base.background.hover}"
        },
        "active-background": {
          "$type": "color",
          "$value": "{primary.content.DEFAULT}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{base.border}"
        },
        "grip-color": {
          "$type": "color",
          "$value": "{base.content.lighter}"
        },
        "active-grip-color": {
          "$type": "color",
          "$value": "{primary.content.inverse}"
        }
      }
    },
    "progress": {
      "track": {
        "color": {
          "$type": "color",
          "$value": "{base.background.component}"
        }
      }
    },
    "slider": {
      "track": {
        "color": {
          "$type": "color",
          "$value": "{base.background.active}"
        }
      },
      "tick": {
        "color": {
          "$type": "color",
          "$value": "{base.border}"
        }
      },
      "thumb": {
        "shadow": {
          "$type": "shadow",
          "$value": "{base.shadow}"
        }
      }
    },
    "popover": {
      "background": {
        "$type": "color",
        "$value": "{base.background.component}"
      },
      "color": {
        "$type": "color",
        "$value": "{base.content.DEFAULT}"
      },
      "border": {
        "color": {
          "$type": "color",
          "$value": "{base.border}"
        }
      },
      "shadow": {
        "$type": "boxShadow",
        "$value": "{base.shadow}"
      },
      "header-divider": {
        "color": {
          "$type": "color",
          "$value": "{base.border}"
        }
      }
    }
  }
}
