{
  "radii": {
    "x-small": { "$type": "borderRadius", "$value": "10px" },
    "small": { "$type": "borderRadius", "$value": "14px" },
    "medium": { "$type": "borderRadius", "$value": "18px" },
    "large": { "$type": "borderRadius", "$value": "24px" },
    "x-large": { "$type": "borderRadius", "$value": "32px" }
  },
  "border": {
    "x-thin": { "$type": "borderWidth", "$value": "2px" },
    "thin": { "$type": "borderWidth", "$value": "2px" }
  },
  "base": {
    "background": {
      "app": { "$type": "color", "$value": "#161616" },
      "component": { "$type": "color", "$value": "#1f1f1f" },
      "hover": { "$type": "color", "$value": "#2a2a2a" },
      "active": { "$type": "color", "$value": "#383838" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#161616" },
      "light": { "$type": "color", "$value": "#d4d4d4" },
      "lighter": { "$type": "color", "$value": "#a3a3a3" },
      "lightest": { "$type": "color", "$value": "#737373" },
      "DEFAULT": { "$type": "color", "$value": "#fafafa" }
    },
    "shadow": {
      "$type": "boxShadow",
      "$value": {
        "x": "0px",
        "y": "6px",
        "blur": "0",
        "spread": "3px",
        "color": "#ffffff",
        "type": "dropShadow"
      }
    }
  },
  "primary": {
    "background": {
      "app": { "$type": "color", "$value": "#3b0764" },
      "component": { "$type": "color", "$value": "#2e1065" },
      "hover": { "$type": "color", "$value": "#4c1d95" },
      "active": { "$type": "color", "$value": "#5b21b6" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#ffffff" },
      "hover": { "$type": "color", "$value": "#c4b5fd" },
      "active": { "$type": "color", "$value": "#ddd6fe" },
      "DEFAULT": { "$type": "color", "$value": "#7c3aed" }
    }
  },
  "secondary": {
    "background": {
      "app": { "$type": "color", "$value": "#164e63" },
      "component": { "$type": "color", "$value": "#0e3a47" },
      "hover": { "$type": "color", "$value": "#155e75" },
      "active": { "$type": "color", "$value": "#0e7490" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#000000" },
      "hover": { "$type": "color", "$value": "#67e8f9" },
      "active": { "$type": "color", "$value": "#a5f3fc" },
      "DEFAULT": { "$type": "color", "$value": "#06b6d4" }
    }
  },
  "success": {
    "background": {
      "app": { "$type": "color", "$value": "#14532d" },
      "component": { "$type": "color", "$value": "#0f3d21" },
      "hover": { "$type": "color", "$value": "#166534" },
      "active": { "$type": "color", "$value": "#15803d" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#000000" },
      "hover": { "$type": "color", "$value": "#86efac" },
      "active": { "$type": "color", "$value": "#bbf7d0" },
      "DEFAULT": { "$type": "color", "$value": "#22c55e" }
    }
  },
  "warning": {
    "background": {
      "app": { "$type": "color", "$value": "#7c2d12" },
      "component": { "$type": "color", "$value": "#5c220e" },
      "hover": { "$type": "color", "$value": "#9a3412" },
      "active": { "$type": "color", "$value": "#c2410c" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#000000" },
      "hover": { "$type": "color", "$value": "#fdba74" },
      "active": { "$type": "color", "$value": "#fed7aa" },
      "DEFAULT": { "$type": "color", "$value": "#f97316" }
    }
  },
  "error": {
    "background": {
      "app": { "$type": "color", "$value": "#7f1d1d" },
      "component": { "$type": "color", "$value": "#611616" },
      "hover": { "$type": "color", "$value": "#991b1b" },
      "active": { "$type": "color", "$value": "#b91c1c" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#ffffff" },
      "hover": { "$type": "color", "$value": "#fca5a5" },
      "active": { "$type": "color", "$value": "#fecaca" },
      "DEFAULT": { "$type": "color", "$value": "#ef4444" }
    }
  },
  "help": {
    "background": {
      "app": { "$type": "color", "$value": "#831843" },
      "component": { "$type": "color", "$value": "#631235" },
      "hover": { "$type": "color", "$value": "#9d174d" },
      "active": { "$type": "color", "$value": "#be185d" }
    },
    "border": { "$type": "color", "$value": "#ffffff" },
    "content": {
      "inverse": { "$type": "color", "$value": "#ffffff" },
      "hover": { "$type": "color", "$value": "#f9a8d4" },
      "active": { "$type": "color", "$value": "#fbcfe8" },
      "DEFAULT": { "$type": "color", "$value": "#ec4899" }
    }
  },
  "font": {
    "family": {
      "header": { "$type": "fontFamilies", "$value": "\"Arial Black\", system-ui, sans-serif" },
      "body": { "$type": "fontFamilies", "$value": "\"Segoe UI\", system-ui, -apple-system, Roboto, sans-serif" }
    },
    "weight": {
      "body": { "$type": "fontWeights", "$value": "500" },
      "heading": { "$type": "fontWeights", "$value": "800" }
    }
  },
  "component": {
    "appbar": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" }
    },
    "breadcrumbs": {
      "color": {
        "hover": { "$type": "color", "$value": "{primary.content.hover}" },
        "current": { "$type": "color", "$value": "{base.content.DEFAULT}" },
        "DEFAULT": { "$type": "color", "$value": "{primary.content.DEFAULT}" }
      },
      "separator": { "color": { "$type": "color", "$value": "{base.content.lighter}" } }
    },
    "break": {
      "line-color": { "$type": "color", "$value": "{base.border}" },
      "content-color": { "$type": "color", "$value": "{base.content.lightest}" }
    },
    "button": {
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" },
      "outline-border-color": { "$type": "color", "$value": "{base.border}" }
    },
    "inputs": {
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" }
    },
    "card": {
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" }
    },
    "code": {
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" }
    },
    "data-grid": {
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" }
    },
    "sidebar": {
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" }
    },
    "checkbox": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "accent": { "$type": "color", "$value": "{primary.content.active}" },
      "checked": {
        "background": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "border": { "color": { "$type": "color", "$value": "{base.border}" } },
        "icon": { "color": { "$type": "color", "$value": "{primary.content.inverse}" } }
      }
    },
    "dock": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": {
        "active": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "DEFAULT": { "$type": "color", "$value": "{base.content.DEFAULT}" }
      },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } }
    },
    "dialog": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } },
      "accent": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
      "shadow": { "$type": "boxShadow", "$value": "{base.shadow}" }
    },
    "drawer": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } }
    },
    "droplist": {
      "drag-preview-shadow": { "$type": "boxShadow", "$value": "{base.shadow}" },
      "ghost-background": { "$type": "color", "$value": "{base.background.hover}" },
      "ghost-border-color": { "$type": "color", "$value": "{base.border}" },
      "swap-indicator": { "background": { "$type": "color", "$value": "{primary.background.active}" } }
    },
    "input": {
      "background": {
        "disabled": { "$type": "color", "$value": "{base.background.hover}" },
        "DEFAULT": { "$type": "color", "$value": "{base.background.component}" }
      },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "accent": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
      "label": { "color": { "$type": "color", "$value": "{base.content.light}" } },
      "placeholder": { "color": { "$type": "color", "$value": "{base.content.lightest}" } },
      "icon": { "color": { "$type": "color", "$value": "{base.content.lighter}" } },
      "error": {
        "color": { "$type": "color", "$value": "{error.content.DEFAULT}" },
        "background": { "$type": "color", "$value": "{error.background.component}" },
        "border": { "color": { "$type": "color", "$value": "{base.border}" } }
      }
    },
    "menu": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } },
      "selected": {
        "background": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "color": { "$type": "color", "$value": "{primary.content.inverse}" }
      },
      "shadow": { "$type": "boxShadow", "$value": "{base.shadow}" }
    },
    "panel": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "expanded": { "background": { "$type": "color", "$value": "{base.background.app}" } },
      "accent": {
        "DEFAULT": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "hover": { "background": { "$type": "color", "$value": "{primary.background.active}" } }
      },
      "active": { "border": { "$type": "color", "$value": "{base.background.active}" } },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } }
    },
    "tree": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "item": {
        "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
        "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } },
        "selected": {
          "color": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
          "background": { "$type": "color", "$value": "{primary.background.active}" }
        },
        "accent": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "active": { "border": { "$type": "color", "$value": "{base.background.active}" } }
      }
    },
    "radio": {
      "color": { "$type": "color", "$value": "{base.border}" },
      "accent": { "$type": "color", "$value": "{primary.content.active}" },
      "checked": {
        "background": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "border": { "color": { "$type": "color", "$value": "{base.border}" } },
        "dot": { "color": { "$type": "color", "$value": "{primary.content.inverse}" } }
      }
    },
    "select": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "accent": {
        "DEFAULT": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "contrast": { "$type": "color", "$value": "{base.background.component}" }
      },
      "label": { "color": { "$type": "color", "$value": "{base.content.light}" } },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } },
      "shadow": { "$type": "boxShadow", "$value": "{base.shadow}" },
      "error": {
        "color": { "$type": "color", "$value": "{error.content.DEFAULT}" },
        "background": { "$type": "color", "$value": "{error.background.component}" },
        "border": { "color": { "$type": "color", "$value": "{base.border}" } }
      }
    },
    "table": {
      "color": {
        "light": { "$type": "color", "$value": "{base.content.lightest}" },
        "DEFAULT": { "$type": "color", "$value": "{base.content.DEFAULT}" }
      },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } },
      "active": { "background": { "$type": "color", "$value": "{base.background.active}" } }
    },
    "datepicker": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" },
      "header": { "color": { "$type": "color", "$value": "{base.content.light}" } },
      "shadow": { "$type": "boxShadow", "$value": "{base.shadow}" }
    },
    "paginator": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "hover": { "background": { "$type": "color", "$value": "{base.background.hover}" } },
      "active": {
        "background": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "color": { "$type": "color", "$value": "{primary.content.inverse}" }
      },
      "disabled": { "color": { "$type": "color", "$value": "{base.content.lightest}" } },
      "ellipsis": { "color": { "$type": "color", "$value": "{base.content.lighter}" } }
    },
    "stepper": {
      "connector": {
        "color": {
          "complete": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
          "DEFAULT": { "$type": "color", "$value": "{base.border}" }
        }
      },
      "color": {
        "pending": { "$type": "color", "$value": "{base.background.active}" },
        "active": {
          "text": { "$type": "color", "$value": "{primary.content.inverse}" },
          "DEFAULT": { "$type": "color", "$value": "{primary.content.DEFAULT}" }
        },
        "complete": {
          "text": { "$type": "color", "$value": "{success.content.inverse}" },
          "DEFAULT": { "$type": "color", "$value": "{success.content.DEFAULT}" }
        },
        "error": {
          "text": { "$type": "color", "$value": "{error.content.inverse}" },
          "DEFAULT": { "$type": "color", "$value": "{error.content.DEFAULT}" }
        }
      },
      "label": { "color": { "$type": "color", "$value": "{base.content.DEFAULT}" } }
    },
    "tabs": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "inactive-background": { "$type": "color", "$value": "{base.background.hover}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "accent": { "$type": "color", "$value": "{primary.content.DEFAULT}" }
    },
    "splitter": {
      "handle": {
        "background": { "$type": "color", "$value": "{base.background.component}" },
        "hover-background": { "$type": "color", "$value": "{base.background.hover}" },
        "active-background": { "$type": "color", "$value": "{primary.content.DEFAULT}" },
        "border-color": { "$type": "color", "$value": "{base.border}" },
        "grip-color": { "$type": "color", "$value": "{base.content.lighter}" },
        "active-grip-color": { "$type": "color", "$value": "{primary.content.inverse}" }
      }
    },
    "progress": {
      "track": { "color": { "$type": "color", "$value": "{base.background.active}" } }
    },
    "slider": {
      "track": { "color": { "$type": "color", "$value": "{base.background.active}" } },
      "tick": { "color": { "$type": "color", "$value": "{base.border}" } },
      "thumb": { "shadow": { "$type": "shadow", "$value": "{base.shadow}" } }
    },
    "popover": {
      "background": { "$type": "color", "$value": "{base.background.component}" },
      "color": { "$type": "color", "$value": "{base.content.DEFAULT}" },
      "border": { "color": { "$type": "color", "$value": "{base.border}" } },
      "border-width": { "$type": "borderWidth", "$value": "2px 2px 6px 2px" },
      "shadow": { "$type": "boxShadow", "$value": "{base.shadow}" },
      "header-divider": { "color": { "$type": "color", "$value": "{base.border}" } }
    }
  }
}
