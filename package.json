{
    "name": "@waggylabs/yumekit",
    "version": "0.5.1-beta.12",
    "description": "Modern Web Component UI Kit",
    "type": "module",
    "main": "dist/yumekit.min.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "module": "./dist/index.js",
            "import": "./dist/index.js",
            "default": "./dist/yumekit.min.js"
        },
        "./react": {
            "types": "./dist/react.d.ts"
        },
        "./components/*": "./dist/components/*",
        "./icons/all.js": "./dist/icons/all.js",
        "./icons/all-filled.js": "./dist/icons/all-filled.js",
        "./icons/registry.js": "./dist/icons/registry.js",
        "./styles/*": "./dist/styles/*",
        "./CHANGELOG.md": "./CHANGELOG.md",
        "./CONTRIBUTING.md": "./CONTRIBUTING.md",
        "./FUNDING.md": "./FUNDING.md"
    },
    "sideEffects": true,
    "files": [
        "dist",
        "llm.txt",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "FUNDING.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "npm run build:tokens && rollup -c && tsc && node scripts/copy-component-types.js",
        "build:tokens": "node scripts/build-tokens.js",
        "prepublishOnly": "npm run build",
        "pretest": "npm run build:tokens",
        "test": "npx web-test-runner --config web-test-runner.config.js --coverage",
        "prestorybook": "npm run build:tokens",
        "storybook": "storybook dev -p 6006",
        "prebuild-storybook": "npm run build:tokens",
        "build-storybook": "storybook build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/waggylabs/yumekit.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/waggylabs"
    },
    "license": "MIT",
    "homepage": "https://www.yumekit.com",
    "devDependencies": {
        "@chromatic-com/storybook": "^5.1.2",
        "@eslint/js": "^10.0.1",
        "@open-wc/testing": "^3.0.0-next.5",
        "@rollup/plugin-terser": "^1.0.0",
        "@storybook/addon-a11y": "^10.3.5",
        "@storybook/addon-docs": "^10.3.5",
        "@storybook/addon-vitest": "^10.3.5",
        "@storybook/html-vite": "^10.3.5",
        "@tokens-studio/sd-transforms": "^2.0.3",
        "@vitest/browser-playwright": "^4.1.2",
        "@vitest/coverage-v8": "^4.1.2",
        "@web/test-runner": "^0.20.0",
        "@web/test-runner-playwright": "^0.11.0",
        "eslint": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-storybook": "10.3.5",
        "globals": "^17.4.0",
        "playwright": "^1.51.1",
        "prettier": "^3.5.3",
        "rollup": "^4.59.0",
        "sinon": "^21.0.1",
        "storybook": "^10.3.5",
        "style-dictionary": "^5.4.0",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^4.1.2"
    }
}
